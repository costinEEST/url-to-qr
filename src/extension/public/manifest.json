{
  "manifest_version": 3,
  "name": "QRick",
  "version": "1.0.1",
  "description": "Turn the page you are on into a QR code, then scan it with your phone.",
  "homepage_url": "https://github.com/costinEEST/url-to-qr",
  "minimum_chrome_version": "153",
  "action": {
    "default_popup": "popup.html",
    "default_title": "QRick — QR code for this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Alt+Shift+Q"
      },
      "description": "Open QRick for the current tab"
    }
  }
}
