{
  "name": "qrick",
  "version": "1.0.0",
  "private": true,
  "license": "0BSD",
  "description": "Turn the page you are on into a QR code \u2014 browser extension and bookmarklet.",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=26.8.2"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run icons && npm run build:extension && npm run build:bookmarklet",
    "build:extension": "node scripts/build-extension.mjs",
    "build:bookmarklet": "node scripts/build-bookmarklet.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && node scripts/build-extension.mjs --zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-bookmarklet.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
